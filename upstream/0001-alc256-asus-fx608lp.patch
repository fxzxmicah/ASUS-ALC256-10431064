From 55380d1ebfac10f1a8ed23d8ce92776a25b33450 Mon Sep 17 00:00:00 2001
From: Fxzx micah <48860358+fxzxmicah@users.noreply.github.com>
Date: Sun, 25 Oct 2026 03:50:07 +0800
Subject: [PATCH] ALSA: hda/realtek: Initialize the headset jack on ASUS
 FX608LP

On ASUS FX608LP systems with ALC256 and subsystem ID 1043:1064, a
headset connected before boot does not record speech until it is
unplugged and reconnected. Repeating headset classification later in
initialization does not restore recording.

Add a first-initialization sequence derived from the OEM audio driver,
before generic pin setup. Temporarily disable the headphone pin, program
the codec coefficients and allow 30 ms for settling, then restore the pin.
Keep the normal ALC256 initialization on subsequent runtime resumes and
chain the existing ASUS headset microphone pin configuration.

The sequence restored cold-boot recording on an ASUS TX Gaming FX608LP
with BIOS FX608LP.315 under Fedora. Headset classification then read a
valid CTIA signature instead of falling back to CTIA after failed checks.
The contribution of each operation has not been isolated.

Select the quirk automatically for 1043:1064 and expose
alc256-asus-fx608lp for explicit model selection on other ALC256 systems.
---
 Documentation/sound/hd-audio/models.rst |  2 +
 sound/hda/codecs/realtek/alc269.c       | 73 +++++++++++++++++++++++++
 2 files changed, 75 insertions(+)

diff --git a/Documentation/sound/hd-audio/models.rst b/Documentation/sound/hd-audio/models.rst
index 1204304..7eef7e3 100644
--- a/Documentation/sound/hd-audio/models.rst
+++ b/Documentation/sound/hd-audio/models.rst
@@ -240,6 +240,8 @@ alc221-hp-mic
     ALC221 headset fixups on HP machines
 alc256-asus-mic
     ALC256 fixups on ASUS machines
+alc256-asus-fx608lp
+    ASUS FX608LP headset microphone cold-boot initialization
 alc256-asus-aio
     ALC256 fixups on ASUS AIO machines
 alc233-eapd
diff --git a/sound/hda/codecs/realtek/alc269.c b/sound/hda/codecs/realtek/alc269.c
index 1623cf9..6fd3968 100644
--- a/sound/hda/codecs/realtek/alc269.c
+++ b/sound/hda/codecs/realtek/alc269.c
@@ -502,6 +502,59 @@ static void alc256_init(struct hda_codec *codec)
 	alc_write_coef_idx(codec, 0x36, 0x5757);
 }
 
+/*
+ * With a headset connected at boot, the FX608LP needs the OEM initialization
+ * sequence before generic pin setup for headset detection to work. Run it only
+ * on the first initialization; runtime resume uses the normal ALC256 setup.
+ */
+static void alc256_asus_fx608lp_init(struct hda_codec *codec)
+{
+	struct alc_spec *spec = codec->spec;
+	static const struct coef_fw coefs[] = {
+		WRITE_COEF(0x1b, 0x8a4b),
+		WRITE_COEF(0x45, 0xd089),
+		WRITE_COEF(0x1b, 0x0a4b),
+		WRITE_COEF(0x46, 0x0004),
+		WRITE_COEF(0x1b, 0x0e4b),
+		{}
+	};
+	unsigned int sense, pin_ctl;
+	int val, err;
+
+	alc256_init(codec);
+	if (spec->done_hp_init)
+		return;
+
+	spec->done_hp_init = true;
+	sense = snd_hda_codec_read(codec, 0x21, 0, AC_VERB_GET_PIN_SENSE, 0);
+	if (sense == ~0U || !(sense & AC_PINSENSE_PRESENCE))
+		return;
+
+	/* This sequence is for the ALC256 variant with bits 5:4 clear. */
+	val = alc_read_coef_idx(codec, 0x5b);
+	if (val < 0 || (val & 0x30))
+		return;
+
+	pin_ctl = snd_hda_codec_read(codec, 0x21, 0,
+				     AC_VERB_GET_PIN_WIDGET_CONTROL, 0);
+	if (pin_ctl > 0xff)
+		return;
+
+	alc_write_coefex_idx(codec, 0x57, 0x03, 0x09a3);
+	err = snd_hda_codec_write(codec, 0x21, 0,
+				 AC_VERB_SET_PIN_WIDGET_CONTROL, 0);
+	if (err < 0 || snd_hda_codec_read(codec, 0x21, 0,
+					AC_VERB_GET_PIN_WIDGET_CONTROL, 0))
+		goto restore;
+
+	alc_process_coef_fw(codec, coefs);
+	msleep(30);
+restore:
+	/* Preserve the output state until generic pin setup takes over. */
+	snd_hda_codec_write(codec, 0x21, 0,
+			    AC_VERB_SET_PIN_WIDGET_CONTROL, pin_ctl);
+}
+
 static void alc256_shutup(struct hda_codec *codec)
 {
 	struct alc_spec *spec = codec->spec;
@@ -2406,6 +2459,16 @@ static void alc_fixup_headset_mode_acer_coldboot(struct hda_codec *codec,
 	}
 }
 
+static void alc256_fixup_asus_fx608lp(struct hda_codec *codec,
+				    const struct hda_fixup *fix, int action)
+{
+	struct alc_spec *spec = codec->spec;
+
+	if (action == HDA_FIXUP_ACT_PRE_PROBE &&
+	    codec->core.vendor_id == 0x10ec0256)
+		spec->init_hook = alc256_asus_fx608lp_init;
+}
+
 static void alc288_update_headset_jack_cb(struct hda_codec *codec,
 				       struct hda_jack_callback *jack)
 {
@@ -4205,6 +4268,7 @@ enum {
 	ALC286_FIXUP_ACER_AIO_HEADSET_MIC,
 	ALC256_FIXUP_ASUS_HEADSET_MIC,
 	ALC256_FIXUP_ASUS_MIC_NO_PRESENCE,
+	ALC256_FIXUP_ASUS_FX608LP,
 	ALC255_FIXUP_PREDATOR_SUBWOOFER,
 	ALC299_FIXUP_PREDATOR_SPK,
 	ALC256_FIXUP_MEDION_HEADSET_NO_PRESENCE,
@@ -5758,6 +5822,13 @@ static const struct hda_fixup alc269_fixups[] = {
 		.chained = true,
 		.chain_id = ALC256_FIXUP_ASUS_HEADSET_MODE
 	},
+	[ALC256_FIXUP_ASUS_FX608LP] = {
+		.type = HDA_FIXUP_FUNC,
+		.v.func = alc256_fixup_asus_fx608lp,
+		.chained_before = true,
+		.chain_id = ALC256_FIXUP_ASUS_MIC_NO_PRESENCE,
+	},
+
 	[ALC256_FIXUP_ASUS_MIC_NO_PRESENCE] = {
 		.type = HDA_FIXUP_PINS,
 		.v.pins = (const struct hda_pintbl[]) {
@@ -7814,6 +7885,7 @@ static const struct hda_quirk alc269_fixup_tbl[] = {
 	SND_PCI_QUIRK(0x1043, 0x103f, "ASUS TX300", ALC282_FIXUP_ASUS_TX300),
 	SND_PCI_QUIRK(0x1043, 0x1044, "ASUS GA403UM", ALC285_FIXUP_ASUS_GA403U_HEADSET_MIC),
 	SND_PCI_QUIRK(0x1043, 0x1054, "ASUS G614FH/FM/FP", ALC287_FIXUP_CS35L41_I2C_2),
+	SND_PCI_QUIRK(0x1043, 0x1064, "ASUS FX608LP", ALC256_FIXUP_ASUS_FX608LP),
 	SND_PCI_QUIRK(0x1043, 0x106d, "Asus K53BE", ALC269_FIXUP_LIMIT_INT_MIC_BOOST),
 	SND_PCI_QUIRK(0x1043, 0x106f, "ASUS VivoBook X515UA", ALC256_FIXUP_ASUS_MIC_NO_PRESENCE),
 	SND_PCI_QUIRK(0x1043, 0x1074, "ASUS G614PH/PM/PP", ALC287_FIXUP_CS35L41_I2C_2),
@@ -8600,6 +8672,7 @@ static const struct hda_model_fixup alc269_fixup_models[] = {
 	{.id = ALC221_FIXUP_HP_MIC_NO_PRESENCE, .name = "alc221-hp-mic"},
 	{.id = ALC256_FIXUP_ASUS_HEADSET_MODE, .name = "alc256-asus-headset"},
 	{.id = ALC256_FIXUP_ASUS_MIC, .name = "alc256-asus-mic"},
+	{.id = ALC256_FIXUP_ASUS_FX608LP, .name = "alc256-asus-fx608lp"},
 	{.id = ALC256_FIXUP_ASUS_AIO_GPIO2, .name = "alc256-asus-aio"},
 	{.id = ALC233_FIXUP_ASUS_MIC_NO_PRESENCE, .name = "alc233-asus"},
 	{.id = ALC233_FIXUP_EAPD_COEF_AND_MIC_NO_PRESENCE, .name = "alc233-eapd"},
-- 
